# Keep secrets and local dev artifacts out of the deployed image.
# `langgraph deploy` reads .env from the local filesystem and uploads the
# values as deployment secrets, so the image itself never needs the file.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json
.venv/
.git/
.DS_Store
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/
**/__pycache__/
# React frontend from Module 2 Part 2 — not part of the agent image.
frontend/
node_modules/
**/node_modules/
