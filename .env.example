# --- Workspace specific to the user ---
# REQUIRED. A unique per-attendee slug (e.g. "jane-doe"). It scopes every named
# resource you create so concurrent attendees don't overwrite each other: the
# LangSmith tracing project, hub prompts, eval datasets, the deployment, run
# rules, and annotation queues. Modules fail loudly if this is unset or still
# the placeholder below. Use lowercase letters, digits, and hyphens only.
WORKSHOP_USER="<first-last>"

# --- LangSmith (required for Modules 2 and 3, recommended everywhere) ---
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-api-key>"

# Interpolates WORKSHOP_USER above — keep that variable defined first.
LANGSMITH_PROJECT="modular-workshops-${WORKSHOP_USER}"

# Optional. Only needed if you switch `utils/models.py` to the LangSmith LLM
# Gateway block. Set to the same value as LANGSMITH_API_KEY.
# LANGSMITH_API_KEY_GATEWAY="<langsmith-api-key>"

# --- Model providers (set whichever your workshop uses) ---
OPENAI_API_KEY="<openai-api-key>"
# ANTHROPIC_API_KEY="<anthropic-api-key>"

# Optional. To route model calls through the LangSmith LLM Gateway, put the
# gateway key in the API key above and uncomment the matching base URL. No code
# change needed — the provider SDKs read these automatically. The gateway must
# be enabled for your org and the key needs the `gateway:invoke` permission.
# OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"
# ANTHROPIC_BASE_URL="https://gateway.smith.langchain.com/anthropic"

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock (optional)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""

# --- Tools used by Module 1 (Deep Agents) and Module 2 (Deploy) ---
TAVILY_API_KEY="<tavily-api-key>"

# --- Databricks (optional, Module 3 §3.1a) ---
# Only needed if you want to pull eval datasets from a Databricks Delta table
# instead of the local examples. A Databricks Free Edition workspace works.
# Leave unset to skip that section. Requires: uv pip install databricks-sql-connector
# DATABRICKS_HOST="dbc-xxxxxxxx-xxxx.cloud.databricks.com"   # no https://
# DATABRICKS_HTTP_PATH="/sql/1.0/warehouses/xxxxxxxxxxxxxxxx" # SQL warehouse HTTP path
# DATABRICKS_TOKEN="dapi..."                                  # personal access token
# Optional — where the demo eval table lives (defaults shown):
# DATABRICKS_CATALOG="workspace"
# DATABRICKS_SCHEMA="default"
# DATABRICKS_EVAL_TABLE="order_agent_evals"
